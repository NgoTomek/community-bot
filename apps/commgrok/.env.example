# Copy to .env.local and fill in. Never commit real values.
#
# Leave the three SUPABASE_* values empty to run in LOCAL DEMO MODE:
# data lives in .data/db.json and live updates use server-sent events.

# Supabase (Project settings -> API). Set all three to switch from local mode to Supabase.
# Check the setup with: npm run db:check
# Public (sent to the browser for Realtime; protected by RLS):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_ or commit it:
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the bot sends in the X-API-Key header to POST /api/proposals
PROPOSALS_API_KEY=change-me

# Optional: we POST {type, event, note, decided_by, team} here when an event is
# published, rejected or sent back to the bots (type: event.published | event.rejected | event.renegotiate).
EVENTS_WEBHOOK_URL=
# Legacy alias, used only if EVENTS_WEBHOOK_URL is empty
PUBLISH_WEBHOOK_URL=

# Public base URL, used in links, the iCal feed and webhooks (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign the login session cookie (HMAC-SHA256). Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it logs everyone out. If empty, a built-in dev-only default is used (not safe for production).
AUTH_SECRET=

# Invite code needed to create an organiser account at /signup (default: commgrok)
ORGANISER_INVITE_CODE=commgrok

# Who must accept before an event publishes: all_teams (default) or any_organiser
NEXT_PUBLIC_APPROVAL_MODE=all_teams

# Optional branding
NEXT_PUBLIC_APP_NAME=CommGrok
NEXT_PUBLIC_CALENDAR_NAME=London Community Calendar
