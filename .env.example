# Copy to .env at the repo root. Both the worker and the web app read this one file.

# ---------- Web app (public, bundled into the browser) ----------
# Supabase -> Project Settings -> API. The anon key is safe to expose; RLS protects writes.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: link shown on /how-it-works
VITE_REPO_URL=https://github.com/NgoTomek/community-bot

# ---------- Worker (server only, never prefix these with VITE_) ----------
SUPABASE_URL=https://your-project.supabase.co
# Service role key bypasses RLS. Keep it on the machine that runs the worker.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Which brain the Bots use: grokbot | openai | mock
#   mock    = deterministic sample data, no network, labelled "Sample data" in the UI
#   openai  = any OpenAI-compatible chat completions endpoint (LLM_* below)
#   grokbot = xAI Grok Bot teammates via the grok-bot skill CLI (macOS + Grok Bot app)
BACKEND=mock

# grokbot backend: path to the grok-bot skill CLI (npx skills add adamanz/grok-bot-skill -g -a cursor)
GROKBOT_SKILL_PATH=~/.cursor/skills/grok-bot/scripts/grokbot.py

# openai backend: any OpenAI-compatible endpoint
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=
LLM_MODEL=grok-4

# Shared secret organisers type in the web app before starting jobs. The worker rejects
# any job whose passcode does not match.
WORKER_PASSCODE=change-me

# Max time for one Bot turn (ms). Each turn is retried once, then fails with a clear error.
TURN_TIMEOUT_MS=120000
