# Copy to .env at the repo root. The web app reads this file (vite envDir is the repo root).
# The worker reads this file and then apps/worker/.env, which overrides it.
# Never commit .env. Never put the service role key in a VITE_ variable.

# ---------- Web app (public, bundled into the browser) ----------
# Leave these empty to stay on the in-browser mock. Approval links then stay on this
# app at /r/:token. Fill them in only when the app should talk to a Supabase project
# and a separate phone app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PHONE_BASE_URL=
VITE_REPO_URL=https://github.com/NgoTomek/community-bot

# ---------- Worker ----------
# Paste the service role key into apps/worker/.env, not here.
# Supabase Dashboard -> Project Settings -> API keys -> service_role.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# grokbot | openai | mock
# mock is deterministic and labelled "Sample data, not a real Bot run" in the UI.
BACKEND=mock

# grokbot: npx skills add adamanz/grok-bot-skill -g -a cursor
GROKBOT_SKILL_PATH=~/.cursor/skills/grok-bot/scripts/grokbot.py

# openai: any OpenAI-compatible chat completions endpoint
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=
LLM_MODEL=grok-4

# One Bot turn. The worker retries once, then fails with a readable error.
TURN_TIMEOUT_MS=120000

# Optional. Without it, "Publish to Luma" returns an export payload and an .ics file.
LUMA_API_KEY=
